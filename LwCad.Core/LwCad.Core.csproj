<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The CAD domain, ported unchanged in behaviour from the WPF LwCadSystemUX
    (LeverageUX_CAD copy, the complete one): models, the keyboard-table function
    catalog, the La*/Lw* table classes, the location engine, recommendation,
    write-back to the CAD tables, and the view models. No UI types: the Blazor
    apps bind to these view models through INotifyPropertyChanged.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LwCadSystemUX</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.3" />
    <!-- SqlClient 7.0.3 brings Pkcs 9.0.x transitively, which has advisories (NU1902/NU1903). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>

</Project>
