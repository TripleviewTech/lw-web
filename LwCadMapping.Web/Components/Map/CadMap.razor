@using LwCadMapping.Web.Geo
@using LwCadMapping.Web.Services
@using LwCadMapping.Web.State
@implements IMapView
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<CadMap> Logger

@* The main map. The host div is left empty for Blazor: ArcGIS and cadmap.js own its children. *@
<div class="cadmap-host" @ref="_host"></div>
@if (_error is not null)
{
    <div class="cadmap-error" role="alert">
        <strong>The ArcGIS map could not start.</strong>
        <span>@_error</span>
    </div>
}
else if (_mapId is null)
{
    <div class="cadmap-loading">Loading the ArcGIS map...</div>
}

@code {
    [Parameter, EditorRequired] public MappingSession Session { get; set; } = default!;

    private ElementReference _host;
    private IJSObjectReference? _module;
    private DotNetObjectReference<CadMap>? _self;
    private string? _mapId;
    private string? _error;

    /// <summary>The JS map id, for the focus maps that share its layers.</summary>
    public string? MapId => _mapId;
    public IJSObjectReference? Module => _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/cadmap.js");
            _self = DotNetObjectReference.Create(this);
            var o = Session.Options;
            var opts = new
            {
                apiKey = o.HasApiKey ? o.ArcGisApiKey : null,
                basemap = BaseMaps.StyleFor(Session.SelectedBaseMap, o.HasApiKey),
                extent = o.AgencyExtent,
                routeUrl = o.RouteUrl,
                operationalLayers = o.OperationalLayers.Select(l => new { title = l.Title, url = l.Url, type = l.Type, visible = l.Visible, minScale = l.MinScale }),
                features = DemoFeatures(),
            };
            _mapId = await _module.InvokeAsync<string>("createMap", TimeSpan.FromSeconds(60), _host, _self, opts);
            StateHasChanged();
            await Session.AttachMap(this);
        }
        catch (JSDisconnectedException) { }
        catch (Exception ex)
        {
            Logger.LogWarning("Map start failed: {Error}", ex.Message);
            _error = ex.Message.Contains("did not load from js.arcgis.com", StringComparison.Ordinal)
                ? "The ArcGIS Maps SDK did not load from js.arcgis.com - check the network or proxy."
                : ex.Message.Split('\n')[0];
            StateHasChanged();
        }
    }

    /// <summary>The mock-up's feature layers, drawn from the demo geography.</summary>
    private static object DemoFeatures()
    {
        static double[] P(GeoPoint p) => [p.Latitude, p.Longitude];
        return new
        {
            sectors = DemoGeography.PoliceSectors.Select(a => new { name = a.Name, ring = a.Ring.Select(P), label = P(a.LabelAt) }),
            districts = DemoGeography.FireDistricts.Select(a => new { name = a.Name, ring = a.Ring.Select(P), label = P(a.LabelAt) }),
            hydrants = DemoGeography.Hydrants.Select(h => new { p = P(h.Point) }),
            schools = DemoGeography.Schools.Select(s => new { name = s.Name, p = P(s.Point) }),
        };
    }

    // ------------------------------------------------------------ JS -> .NET

    [JSInvokable]
    public Task OnMapClick(double lat, double lon, string? graphicId, bool fromFocus) =>
        Session.OnMapClick(lat, lon, graphicId, fromFocus);

    [JSInvokable]
    public Task OnCalloutClosed() => Session.SetCalloutOpen(false);

    // ------------------------------------------------------------ IMapView

    private async Task Call(string fn, params object?[] args)
    {
        if (_module is null || _mapId is null) return;
        try
        {
            await _module.InvokeVoidAsync(fn, [_mapId, .. args]);
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
    }

    private async Task<T?> CallFor<T>(string fn, params object?[] args)
    {
        if (_module is null || _mapId is null) return default;
        try
        {
            return await _module.InvokeAsync<T>(fn, [_mapId, .. args]);
        }
        catch (JSDisconnectedException) { return default; }
        catch (TaskCanceledException) { return default; }
    }

    public async Task ShowCall(MapCall call)
    {
        if (call.Point is not { } p) return;
        var vp = await GetViewpoint();
        await Centre(p, Math.Max(vp?.Zoom ?? 16, 16));
    }

    public Task ShowUnits(IEnumerable<GeoPoint> positions) => FitTo(positions);

    public Task Select(MapGraphic? graphic, bool bringIntoView) =>
        Call("select", graphic is null ? null : new { lat = graphic.Lat, lon = graphic.Lon }, bringIntoView);

    public Task Centre(GeoPoint point, double? zoom = null) => Call("goTo", point.Latitude, point.Longitude, zoom);

    public Task ZoomBy(double levels) => Call("zoomBy", levels);

    public Task FullExtent() => Call("fullExtent");

    public Task FitTo(IEnumerable<GeoPoint> points) =>
        Call("fitTo", points.Select(p => new[] { p.Latitude, p.Longitude }).ToList());

    public Task<MapViewpoint?> GetViewpoint() => CallFor<MapViewpoint>("getViewpoint");

    public Task SetMarking(bool on) => Call("setMarking", on);

    public Task<string?> Snapshot() => CallFor<string>("snapshot");

    public async Task<string> CopyToClipboard() => await CallFor<string>("copyToClipboard") ?? "The map is not ready.";

    public Task Print() => Call("print");

    public Task Draw(IReadOnlyList<MapGraphic> graphics, IReadOnlyList<MapLayerState> layers, string markerTheme) =>
        Call("draw", graphics, layers, markerTheme);

    public Task SetCallout(MapGraphic? g) =>
        Call("setCallout", g is null ? null : new { title = g.Title, subtitle = g.Subtitle, address = g.Address, footer = g.Footer, lat = g.Lat, lon = g.Lon });

    public Task SetBaseMap(string? style) => Call("setBasemap", style);

    public Task SetCoordinateFormats(bool dec, bool deg, bool map) => Call("setCoordinateFormats", dec, deg, map);

    public async Task<RouteResult> Route(GeoPoint from, GeoPoint to)
    {
        var r = await CallFor<RouteResult>("route", new[] { from.Latitude, from.Longitude }, new[] { to.Latitude, to.Longitude });
        if (r is not null) return r;
        var metres = from.DistanceTo(to);
        return new RouteResult(metres / 1609.344, metres / 1000, false, "The map did not answer.");
    }

    public Task ClearRoute() => Call("clearRoute");

    public Task Refresh() => Call("refresh");

    public async ValueTask DisposeAsync()
    {
        Session.DetachMap();
        if (_module is not null)
        {
            try
            {
                if (_mapId is not null) await _module.InvokeVoidAsync("destroyMap", _mapId);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        _self?.Dispose();
    }
}
