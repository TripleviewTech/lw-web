@page "/"
@using LwCadMapping.Web.Services
@using LwCadMapping.Web.State
@using LwCadMapping.Web.Components.Map
@using LwCadMapping.Web.Components.Shell
@implements IAsyncDisposable
@inject MappingSession S
@inject CadBoard Board
@inject IJSRuntime JS
@inject IThemeChangeService ThemeService

<PageTitle>LW CAD Mapping</PageTitle>

<div class="lw-shell">
    <TopBar S="S" OnToggleTheme="ToggleTheme" OnExit="Exit" />
    <MapToolbar S="S" />

    @* The work area is DevExpress splitters: map row over monitor row, and within each row
       the panels side by side. Drag a separator to share the space differently; the sizes are
       kept in this browser. In DxSplitter 26.1 the LAST pane of a splitter always takes the
       remaining space and ignores Size, so the panes before it are sized as "the rest minus
       the last pane" (calc), and the last pane's size is measured after a drag. A folded side
       panel keeps its 38px rail. *@
    <DxSplitter CssClass="lw-split lw-split-rows" Orientation="Orientation.Vertical" Width="100%" SeparatorSize="8">
        <Panes>
            <DxSplitterPane CssClass="lw-pane-top" Size="@($"calc(100% - {_bottomPx + Gap}px)")" SizeChanged="@(_ => MeasureAsync("bottom"))" MinSize="200px">
                <DxSplitter CssClass="lw-split lw-split-cols" Width="100%" Height="100%" SeparatorSize="8">
                    <Panes>
                        <DxSplitterPane CssClass="lw-pane-focus" Size="@(_nudge ? $"calc({FocusPx}px + 0px)" : $"{FocusPx}px")" SizeChanged="@(_ => MeasureAsync("focus"))"
                                        MinSize="@(S.IsFocusPanelExpanded ? "200px" : $"{Folded}px")" MaxSize="45%" AllowResize="S.IsFocusPanelExpanded">
                            <FocusPanel S="S" Map="_map" />
                        </DxSplitterPane>
                        <DxSplitterPane CssClass="lw-pane-map" Size="@($"calc(100% - {FocusPx + ControlsPx + 2 * Gap}px{Nudge})")" SizeChanged="@(_ => MeasureAsync("focus", "controls"))" MinSize="320px">
                    <section class="lw-card map-card @(S.IsMarking ? "marking" : "")">
                        <CadMap @ref="_map" Session="S" />

                        <div class="map-chrome">
                            <div class="zoom-group">
                                <button type="button" title="Zoom in (+)" aria-label="Zoom in" @onclick="@(() => S.ZoomBy(1))"><Icon Name="plus" /></button>
                                <button type="button" title="Zoom out (-)" aria-label="Zoom out" @onclick="@(() => S.ZoomBy(-1))"><Icon Name="minus" /></button>
                            </div>
                            <button type="button" class="chrome-btn" title="Reset Map - back to the zoom extent (Ctrl+R)" aria-label="Reset map" @onclick="@(() => S.ResetMap())"><Icon Name="home" /></button>
                            <button type="button" class="chrome-btn" title="Full extent - the agency's whole map" aria-label="Full extent" @onclick="@(() => S.FullExtent())"><Icon Name="extent" /></button>
                            <button type="button" class="chrome-btn" title="Show all units" aria-label="Show all units" @onclick="@(() => S.ShowAllUnits())"><Icon Name="truck" /></button>
                        </div>

                        @if (S.HasRoute)
                        {
                            <div class="distance-box">
                                <div class="t"><Icon Name="route" /> @S.RouteTitle</div>
                                <div><span class="muted">Distance:</span> <b>@S.RouteMiles</b> <span class="muted">miles ·</span> <b>@S.RouteKm</b> <span class="muted">km</span></div>
                                <div class="muted small">@S.RouteNote</div>
                            </div>
                        }

                        @if (S.IsMarking)
                        {
                            <div class="marking-banner">Click the map to mark a location · Esc cancels</div>
                        }

                        <div class="map-note">
                            @S.SelectedBaseMap ·
                            @(S.HasApiKey ? "ArcGIS basemap styles" : "OpenStreetMap - no ArcGIS key")
                            · @(S.IsDemoBoard ? "Demo board, approximate demo geography" : S.HasApiKey ? "Calls geocoded by ArcGIS" : "Calls on approximate demo geography")
                        </div>
                        <div class="map-attribution">@(S.HasApiKey && S.SelectedBaseMap != BaseMaps.OpenStreetMap ? "Powered by Esri · Esri, HERE, Garmin, FAO, NOAA, USGS, © OpenStreetMap contributors" : "Powered by Esri · © OpenStreetMap contributors")</div>
                    </section>
                        </DxSplitterPane>
                        <DxSplitterPane CssClass="lw-pane-controls">
                            <ControlsPanel S="S" />
                        </DxSplitterPane>
                    </Panes>
                </DxSplitter>
            </DxSplitterPane>
            <DxSplitterPane CssClass="lw-pane-bottom">
                <DxSplitter CssClass="lw-split lw-split-cols" Width="100%" Height="100%" SeparatorSize="8">
                    <Panes>
                        <DxSplitterPane CssClass="lw-pane-monitor" Size="@($"calc(100% - {_selectionPx + Gap}px)")" SizeChanged="@(_ => MeasureAsync("selection"))" MinSize="360px">
                            <MonitorPanel S="S" />
                        </DxSplitterPane>
                        <DxSplitterPane CssClass="lw-pane-selection">
                            <SelectionPanel S="S" />
                        </DxSplitterPane>
                    </Panes>
                </DxSplitter>
            </DxSplitterPane>
        </Panes>
    </DxSplitter>

    <footer class="lw-status">
        <span class="status-text">@S.Status</span>
        @if (!string.IsNullOrEmpty(S.Status))
        {
            <button type="button" class="icon-btn small" title="Clear the status line" aria-label="Clear the status line" @onclick="ClearStatus"><Icon Name="x" Size="13" /></button>
        }
        <span class="spacer"></span>
        <span class="source @(S.Board.IsLive ? "live" : "demo")" title="@S.Board.SourceStatus @S.Board.GeocodeStatus">
            @(S.Board.IsLoading ? "Starting..." : S.Board.IsLive ? "CAD database - read only" : "Demo board")
            @if (S.Board.LastError is { } err)
            {
                <span class="err" title="@err"> · last read failed</span>
            }
        </span>
        <span class="hints">Drag pans · Wheel zooms · Ctrl+K searches · Ctrl+M marks · Ctrl+G GPS · Esc clears</span>
    </footer>
</div>

<DxPopup @bind-Visible="S.IsAboutOpen" HeaderText="LW CAD Mapping" Width="540px" CloseOnEscape="true" ShowFooter="true" CssClass="about-popup">
    <BodyContentTemplate>
        <div class="about">
            <div class="muted">Larimore Associates Public Safety Systems</div>
            <p>
                The web CAD Mapping program: the design and functions of the LwCadMappingUX mock-up on a real ESRI map
                (ArcGIS Maps SDK for JavaScript 5.1) and real CAD calls and units read through LwCad.Core.
            </p>
            <p>
                The screens reach the map only through IMapView (show call, show units, select, centre, zoom, fit, mark, snapshot),
                implemented by the CadMap component over ArcGIS JS. This app is read-only: it never writes to CAD.
            </p>
            <dl>
                <dt>Data</dt><dd>@S.Board.SourceStatus</dd>
                <dt>Locating</dt><dd>@S.Board.GeocodeStatus</dd>
                <dt>Base maps</dt><dd>@(S.HasApiKey ? "ArcGIS basemap styles (API key configured)." : "OpenStreetMap - Esri basemap styles need an ArcGIS API key.")</dd>
                <dt>Units</dt><dd>No AVL feed in Lowell (ADR-007): units are shown at their call or station. GPS tracking is simulated, demo board only.</dd>
                <dt>Keys</dt><dd>Ctrl+K search · Ctrl+M mark · Ctrl+G GPS · Ctrl+R reset · Ctrl+B / Ctrl+L panels · Ctrl+Shift+C copy map · F1 about · Esc backs out</dd>
            </dl>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <DxButton Text="Close" RenderStyle="ButtonRenderStyle.Primary" Click="@(() => { S.IsAboutOpen = false; })" />
    </FooterContentTemplate>
</DxPopup>

@code {
    private CadMap? _map;
    private IJSObjectReference? _shell;

    // Pane sizes (DxSplitter), in px. Defaults are the mock-up's: 274 / 294 px side panels, a
    // 250 px monitor row and a 440 px selection panel. Dragged sizes are kept in localStorage.
    private const int Folded = 38;
    private const int Gap = 8;
    private int _focusPx = 274;
    private int _controlsPx = 294;
    private int _bottomPx = 250;
    private int _selectionPx = 440;

    private int FocusPx => S.IsFocusPanelExpanded ? _focusPx : Folded;

    // DxSplitter keeps a dragged size until it is handed a DIFFERENT Size. A separator next to a
    // folded panel can still be dragged, which would leave the 38px rail half open; flipping this
    // suffix ("" / " + 0px") re-sends the same size so the splitter snaps the rail back.
    private bool _nudge;
    private string Nudge => _nudge ? " + 0px" : "";
    private int ControlsPx => S.IsControlsPanelExpanded ? _controlsPx : Folded;

    /// <summary>After a drag: read the panes' real sizes back, keep them, and save them.</summary>
    private async Task MeasureAsync(params string[] panes)
    {
        if (_shell is null) return;
        try
        {
            // A folded side panel must stay a 38px rail whatever was dragged.
            if (await FoldedRailMovedAsync("focus", S.IsFocusPanelExpanded) |
                await FoldedRailMovedAsync("controls", S.IsControlsPanelExpanded))
            {
                _nudge = !_nudge;
            }

            foreach (var pane in panes)
            {
                var size = await _shell.InvokeAsync<double[]?>("paneSize", ".lw-pane-" + pane);
                if (size is null || size.Length < 2) continue;
                var px = (int)Math.Round(pane == "bottom" ? size[1] : size[0]);
                if (px <= Folded) continue;  // a folded rail is not a size to keep
                switch (pane)
                {
                    case "focus" when S.IsFocusPanelExpanded: _focusPx = px; break;
                    case "controls" when S.IsControlsPanelExpanded: _controlsPx = px; break;
                    case "bottom": _bottomPx = px; break;
                    case "selection": _selectionPx = px; break;
                    default: continue;
                }
                // The Focus Maps width is not kept: every visit opens it at the width GPS Tracking needs.
                if (pane != "focus")
                    await _shell.InvokeVoidAsync("saveLayout", pane, px.ToString(System.Globalization.CultureInfo.InvariantCulture));
            }
            StateHasChanged();
        }
        catch (JSDisconnectedException) { }
    }

    private bool _focusFitted;

    /// <summary>
    /// Opens the Focus Maps section at the width the GPS Tracking list needs (its widest row, the
    /// header controls and the scroll bar), measured once the units have arrived, instead of a fixed
    /// default or a remembered wide size. Runs once per visit; dragging afterwards is the user's.
    /// </summary>
    private async Task FitFocusPanelAsync()
    {
        if (_focusFitted || _shell is null || !S.IsFocusPanelExpanded || Board.Current.IsLoading) return;
        if (S.IsGpsTrackingExpanded && S.Units.Count == 0) return;  // wait for the rows to measure
        try
        {
            var px = await _shell.InvokeAsync<double?>("focusPanelWidth");
            if (px is not > 0) return;
            _focusFitted = true;
            var fitted = Math.Clamp((int)Math.Ceiling(px.Value), 200, 600);
            if (fitted == _focusPx) return;
            _focusPx = fitted;
            StateHasChanged();
        }
        catch (JSDisconnectedException) { }
    }

    private async Task<bool> FoldedRailMovedAsync(string pane, bool expanded)
    {
        if (expanded || _shell is null) return false;
        var size = await _shell.InvokeAsync<double[]?>("paneSize", ".lw-pane-" + pane);
        return size is { Length: > 0 } && Math.Abs(size[0] - Folded) > 1;
    }

    private async Task LoadLayoutAsync()
    {
        if (_shell is null) return;
        try
        {
            _controlsPx = await Saved("controls", _controlsPx);
            _bottomPx = await Saved("bottom", _bottomPx);
            _selectionPx = await Saved("selection", _selectionPx);
            StateHasChanged();
        }
        catch (JSDisconnectedException) { }
    }

    private async Task<int> Saved(string key, int fallback)
    {
        var text = await _shell!.InvokeAsync<string?>("loadLayout", key);
        return int.TryParse(text, out var px) && px > Folded ? px : fallback;
    }
    private DotNetObjectReference<Home>? _self;
    private PeriodicTimer? _gpsTimer;
    private readonly CancellationTokenSource _cts = new();

    /// <summary>The call CAD opened the map on (LwCadMapping --event): /?event=2026-0000002</summary>
    [SupplyParameterFromQuery(Name = "event")] public string? StartEvent { get; set; }

    /// <summary>The unit CAD had selected, used when no call is given: /?unit=C206</summary>
    [SupplyParameterFromQuery(Name = "unit")] public string? StartUnit { get; set; }

    protected override void OnInitialized()
    {
        S.SetStartTarget(StartEvent, StartUnit);
        S.Changed += OnSessionChanged;
        Board.Changed += OnBoardChanged;
        _ = RunGpsTimer();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            await FitFocusPanelAsync();
            return;
        }
        // The board may have been published before this circuit subscribed.
        if (Board.Current.Version != S.Board.Version || S.Board.IsLoading != Board.Current.IsLoading) await S.OnBoardChanged(Board.Current);

        _shell = await JS.InvokeAsync<IJSObjectReference>("import", "./js/shell.js");
        await LoadLayoutAsync();
        _self = DotNetObjectReference.Create(this);
        await _shell.InvokeVoidAsync("registerShortcuts", _self);
    }

    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnBoardChanged(BoardSnapshot snapshot) =>
        _ = InvokeAsync(async () =>
        {
            try { await S.OnBoardChanged(snapshot); }
            catch (JSDisconnectedException) { }
        });

    private async Task RunGpsTimer()
    {
        _gpsTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await _gpsTimer.WaitForNextTickAsync(_cts.Token))
            {
                if (S.IsGpsTracking) await InvokeAsync(S.OnGpsTimer);
            }
        }
        catch (OperationCanceledException) { }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    [JSInvokable]
    public async Task OnShortcut(string name)
    {
        switch (name)
        {
            case "mark": await S.SetMarking(!S.IsMarking); break;
            case "gps": await S.SetGpsTracking(!S.IsGpsTracking); break;
            case "reset": await S.ResetMap(); break;
            case "focusPanel": S.IsFocusPanelExpanded = !S.IsFocusPanelExpanded; break;
            case "controlsPanel": S.IsControlsPanelExpanded = !S.IsControlsPanelExpanded; break;
            case "copy": await S.CopyMap(); break;
            case "about": S.IsAboutOpen = true; break;
            case "escape": await S.Escape(); break;
        }
        StateHasChanged();
    }

    private async Task ToggleTheme()
    {
        S.IsDark = !S.IsDark;
        await ThemeService.SetTheme(Themes.Fluent.Clone(p => p.Mode = S.IsDark ? ThemeMode.Dark : ThemeMode.Light));
        if (_shell is not null) await _shell.InvokeVoidAsync("setTheme", S.IsDark);
        if (_map is not null) await _map.Refresh();
        S.Status = S.IsDark ? "Dark theme." : "Light theme.";
    }

    private void ClearStatus() => S.Status = null;

    private async Task Exit()
    {
        // A browser only lets script close a window it opened; say so when it stays open.
        try { await JS.InvokeVoidAsync("close"); } catch (JSException) { }
        S.Status = "Exit - the browser keeps a tab it did not open; close it with the tab's own close button.";
    }

    public async ValueTask DisposeAsync()
    {
        S.Changed -= OnSessionChanged;
        Board.Changed -= OnBoardChanged;
        _cts.Cancel();
        _gpsTimer?.Dispose();
        if (_shell is not null)
        {
            try
            {
                await _shell.InvokeVoidAsync("unregisterShortcuts");
                await _shell.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        _self?.Dispose();
        _cts.Dispose();
    }
}
