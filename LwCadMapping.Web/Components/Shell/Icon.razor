@* Line icons (24 px grid, stroke) for the toolbar, panels and icon bars. *@
<svg class="lw-icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Name)
    {
        case "reset": <path d="M3 12a9 9 0 1 0 3-6.7" /><path d="M3 4v5h5" /> break;
        case "pin": <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /> break;
        case "gps": <path d="M3 11l18-8-8 18-2-8-8-2z" /> break;
        case "search": <circle cx="11" cy="11" r="7" /><path d="M20 20l-4-4" /> break;
        case "copy": <rect x="8" y="8" width="13" height="13" rx="2" /><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3" /> break;
        case "print": <path d="M6 9V3h12v6" /><rect x="3" y="9" width="18" height="8" rx="2" /><path d="M6 14h12v7H6z" /> break;
        case "layers": <path d="M12 3l9 5-9 5-9-5 9-5z" /><path d="M3 13l9 5 9-5" /> break;
        case "focus": <circle cx="12" cy="12" r="3" /><path d="M12 2v4M12 18v4M2 12h4M18 12h4" /><circle cx="12" cy="12" r="8" /> break;
        case "info": <circle cx="12" cy="12" r="9" /><path d="M12 11v6M12 7.5v.5" /> break;
        case "eye": <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /> break;
        case "history": <path d="M3 12a9 9 0 1 0 3-6.7" /><path d="M3 4v5h5" /><path d="M12 7v5l3 2" /> break;
        case "home": <path d="M3 11l9-7 9 7" /><path d="M5 10v10h14V10" /><path d="M10 20v-6h4v6" /> break;
        case "clip": <path d="M21 11.5l-8.6 8.6a5 5 0 0 1-7.1-7.1l8.6-8.6a3.3 3.3 0 0 1 4.7 4.7l-8.6 8.6a1.7 1.7 0 0 1-2.4-2.4l7.9-7.9" /> break;
        case "camera": <path d="M4 7h3l2-3h6l2 3h3v13H4z" /><circle cx="12" cy="13" r="3.5" /> break;
        case "shield": <path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z" /> break;
        case "alert": <path d="M12 3l10 18H2L12 3z" /><path d="M12 10v5M12 18v.5" /> break;
        case "globe": <circle cx="12" cy="12" r="9" /><path d="M3 12h18" /><path d="M12 3a14 14 0 0 1 0 18a14 14 0 0 1 0-18z" /> break;
        case "x": <path d="M6 6l12 12M18 6L6 18" /> break;
        case "map": <path d="M9 4L3 6v14l6-2 6 2 6-2V4l-6 2-6-2z" /><path d="M9 4v14M15 6v14" /> break;
        case "zoom": <circle cx="11" cy="11" r="7" /><path d="M20 20l-4-4M11 8v6M8 11h6" /> break;
        case "chev-left": <path d="M11 6l-6 6 6 6M19 6l-6 6 6 6" /> break;
        case "chev-right": <path d="M13 6l6 6-6 6M5 6l6 6-6 6" /> break;
        case "sun": <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /> break;
        case "moon": <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" /> break;
        case "lock": <rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /> break;
        case "route": <circle cx="6" cy="18" r="2.5" /><circle cx="18" cy="6" r="2.5" /><path d="M8.5 18H15a3 3 0 0 0 0-6H9a3 3 0 0 1 0-6h6.5" /> break;
        case "plus": <path d="M12 5v14M5 12h14" /> break;
        case "minus": <path d="M5 12h14" /> break;
        case "extent": <path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5" /> break;
        case "truck": <path d="M3 6h11v10H3zM14 10h4l3 3v3h-7z" /><circle cx="7" cy="18" r="1.8" /><circle cx="17" cy="18" r="1.8" /> break;
        case "star": <path d="M12 3l2.7 6 6.3.6-4.8 4.3 1.4 6.4L12 17l-5.6 3.3 1.4-6.4L3 9.6 9.3 9z" /> break;
        case "check": <path d="M5 12l5 5 9-10" /> break;
        default: <circle cx="12" cy="12" r="8" /> break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 16;
    [Parameter] public string? Class { get; set; }
}
